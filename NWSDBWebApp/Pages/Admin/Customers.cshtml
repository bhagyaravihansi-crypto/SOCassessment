@page "/Admin/Customers"
@model CustomersModel

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            <partial name="_AdminSidebar" />
        </div>
        <div class="col-lg-9">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger shadow-sm mb-3">
                    <strong>Customer API Error:</strong>
                    <br />
                    @Model.ErrorMessage
                </div>
            }
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h3 class="fw-bold">Customer Management</h3>
                    <p class="text-muted mb-0">View and manage registered NWSDB customer accounts.</p>
                </div>
                <div>
                    <button type="button" class="btn btn-primary" onclick="alert('Demo: Add New Customer (UI only)')">Add New Customer</button>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">Total Customers</small>
                        <div class="h4 fw-bold">@Model.TotalCustomers</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">Active Customers</small>
                        <div class="h4 fw-bold text-success">@Model.ActiveCustomers</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">Inactive Customers</small>
                        <div class="h4 fw-bold text-secondary">@Model.InactiveCustomers</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">New Customers</small>
                        <div class="h4 fw-bold text-primary">@Model.NewCustomers</div>
                    </div>
                </div>
            </div>

            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <form method="get" class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small">Search Customer</label>
                            <input asp-for="SearchTerm" class="form-control" placeholder="Name, email or account number" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Status</label>
                            <select asp-for="StatusFilter" class="form-select">
                                <option value="All">All</option>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Search</button>
                            <a class="btn btn-outline-secondary" href="/Admin/Customers">Clear</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold">Registered Customers</h6>
                    <div class="table-responsive mt-3">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Customer ID</th>
                                    <th>Full Name</th>
                                    <th>NIC</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Status</th>
                                    <th>Registered</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Customers)
                                {
                                    <tr>
                                        <td>@c.CustomerId</td>
                                        <td>@c.FullName</td>
                                        <td>@c.NIC</td>
                                        <td>@c.Email</td>
                                        <td>@c.Phone</td>
                                        <td>
                                            @if (c.Status == "Active")
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>@c.RegistrationDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="alert('Demo: View @c.CustomerId')">View</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="alert('Demo: Edit @c.CustomerId')">Edit</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="alert('Demo: Delete @c.CustomerId')">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-4 card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold">Customer Account Management</h6>
                    <p class="text-muted small mb-0">Administrators can review customer account information and manage registered customer records. The data shown on this page is sample/demo data for UI demonstration only.</p>
                </div>
            </div>
        </div>
    </div>
</div>