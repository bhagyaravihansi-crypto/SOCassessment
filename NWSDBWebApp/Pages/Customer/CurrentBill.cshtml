@page "/Customer/CurrentBill"
@model CurrentBillModel
@{
    ViewData["Title"] = "Current Bill";
    ViewData["ActiveDashboard"] = "CurrentBill";
}

<div class="container py-4">
    <div class="row">

        <div class="col-lg-3 mb-4">
            <partial name="_CustomerSidebar" />
        </div>

        <div class="col-lg-9">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h3 class="fw-bold">Current Bill</h3>

                    <p class="text-muted mb-0">
                        @Model.CustomerName &middot;
                        <span class="fw-semibold">@Model.AccountNumber</span>
                    </p>
                </div>

                <div class="text-end">
                    <small class="text-muted">
                        Billing period: @Model.BillingPeriod
                    </small>
                </div>
            </div>

            <!-- Bill Summary + Usage -->
            <div class="row g-3 mb-4">

                <!-- Bill Summary -->
                <div class="col-md-6">
                    <div class="card p-3 shadow-sm h-100">

                        <h6 class="fw-bold">Bill Summary</h6>

                        <div class="mt-2">

                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Issue Date</small>
                                <strong>
                                    @Model.IssueDate.ToString("dd MMM yyyy")
                                </strong>
                            </div>

                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Due Date</small>
                                <strong>
                                    @Model.DueDate.ToString("dd MMM yyyy")
                                </strong>
                            </div>

                            <div class="d-flex justify-content-between">
                                <small class="text-muted">Payment Status</small>
                                <strong class="text-@((Model.IsOverdue) ? "danger" : "success")">
                                    @Model.PaymentStatus
                                </strong>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-baseline">

                                <div>
                                    <small class="text-muted">
                                        Total Amount Due
                                    </small>
                                </div>

                                <div class="h4 fw-bold text-danger">
                                    LKR @Model.TotalDue.ToString("N2")
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

                <!-- Meter / Usage Details -->
                <div class="col-md-6">

                    <div class="card p-3 shadow-sm h-100">

                        <h6 class="fw-bold">
                            Meter / Usage Details
                        </h6>

                        <div class="mt-2">

                            <div class="d-flex justify-content-between">
                                <small class="text-muted">
                                    Previous Reading
                                </small>
                                <strong>@Model.PreviousReading</strong>
                            </div>

                            <div class="d-flex justify-content-between">
                                <small class="text-muted">
                                    Current Reading
                                </small>
                                <strong>@Model.CurrentReading</strong>
                            </div>

                            <div class="d-flex justify-content-between">
                                <small class="text-muted">
                                    Units Consumed (m³)
                                </small>
                                <strong>@Model.UnitsConsumed</strong>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Bill Breakdown -->
            <div class="card mb-4 shadow-sm">

                <div class="card-body">

                    <h6 class="fw-bold">
                        Bill Breakdown
                    </h6>

                    <div class="table-responsive mt-3">

                        <table class="table table-borderless">

                            <tbody>

                                @foreach (var c in Model.Charges)
                                {
                                    <tr>

                                        <td class="ps-0">
                                            @c.Description
                                        </td>

                                        <td class="text-end pe-0">
                                            LKR @c.Amount.ToString("N2")
                                        </td>

                                    </tr>
                                }

                                <tr class="border-top">

                                    <td class="ps-0 fw-bold">
                                        Total
                                    </td>

                                    <td class="text-end pe-0 fw-bold text-danger">
                                        LKR @Model.TotalDue.ToString("N2")
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                    <!-- Buttons -->
                    <div class="mt-3 d-flex gap-2">

                        <!-- Pay Current Bill -->
                        <a class="btn btn-primary"
                           href="/Customer/OnlinePayment?amount=@Model.TotalDue">
                            Pay Now
                        </a>

                        <!-- View Bill -->
                        <a class="btn btn-outline-primary"
                           href="#">
                            Download / View Bill
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>