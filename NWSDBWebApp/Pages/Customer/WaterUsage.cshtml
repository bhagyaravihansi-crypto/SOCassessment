@page "/Customer/WaterUsage"
@model WaterUsageModel
@{
    ViewData["Title"] = "Water Usage";
    ViewData["ActiveDashboard"] = "WaterUsage";
}

<div class="container py-4">
    <div class="row">

        <!-- Customer Sidebar -->
        <div class="col-lg-3 mb-4">
            <partial name="_CustomerSidebar" />
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold">Water Usage</h3>
                    <p class="text-muted mb-0">
                        Monitor your monthly water consumption
                    </p>
                </div>

                <div class="text-end">
                    <small class="text-muted">Account</small>
                    <div class="fw-semibold">@Model.AccountNumber</div>
                </div>
            </div>


            <!-- Current Usage Summary -->
            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">Current Usage</small>

                        <div class="h3 fw-bold text-primary">
                            @Model.CurrentUsage m³
                        </div>

                        <small class="text-muted">
                            @Model.CurrentMonth
                        </small>
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">Previous Usage</small>

                        <div class="h3 fw-bold">
                            @Model.PreviousUsage m³
                        </div>

                        <small class="text-muted">
                            Previous month
                        </small>
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">Usage Status</small>

                        <div class="h4 fw-bold text-success">
                            @Model.UsageStatus
                        </div>

                        <small class="text-muted">
                            Compared with previous month
                        </small>
                    </div>
                </div>

            </div>


            <!-- Meter Reading Details -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        Current Meter Reading
                    </h5>

                    <div class="row">

                        <div class="col-md-4 mb-3">
                            <small class="text-muted">
                                Previous Meter Reading
                            </small>

                            <div class="h5 fw-bold">
                                @Model.PreviousMeterReading
                            </div>
                        </div>


                        <div class="col-md-4 mb-3">
                            <small class="text-muted">
                                Current Meter Reading
                            </small>

                            <div class="h5 fw-bold">
                                @Model.CurrentMeterReading
                            </div>
                        </div>


                        <div class="col-md-4 mb-3">
                            <small class="text-muted">
                                Units Consumed
                            </small>

                            <div class="h5 fw-bold text-primary">
                                @Model.CurrentUsage m³
                            </div>
                        </div>

                    </div>

                </div>

            </div>


            <!-- Monthly Usage Overview -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Monthly Usage Overview
                            </h5>

                            <small class="text-muted">
                                Water consumption for the last six months
                            </small>
                        </div>

                    </div>


                    <!-- Simple Usage Bars -->
                    <div class="mt-4">

                        @foreach (var usage in Model.MonthlyUsage)
                        {
                            <div class="mb-3">

                                <div class="d-flex justify-content-between mb-1">

                                    <span class="fw-semibold">
                                        @usage.Month
                                    </span>

                                    <span class="text-muted">
                                        @usage.Units m³
                                    </span>

                                </div>

                                <div class="progress" style="height: 10px;">

                                    @{
                                        var percentage = Math.Min(
                                            (usage.Units / Model.MaximumUsage) * 100,
                                            100
                                        );
                                    }

                                    <div class="progress-bar bg-primary"
                                         role="progressbar"
                                         style="width: @percentage%;"
                                         aria-valuenow="@usage.Units"
                                         aria-valuemin="0"
                                         aria-valuemax="@Model.MaximumUsage">
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- Monthly Usage Table -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        Monthly Usage Details
                    </h5>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>
                                    <th>Month</th>
                                    <th>Previous Reading</th>
                                    <th>Current Reading</th>
                                    <th>Units Consumed</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var usage in Model.MonthlyUsage)
                                {
                                    <tr>

                                        <td class="fw-semibold">
                                            @usage.Month
                                        </td>

                                        <td>
                                            @usage.PreviousReading
                                        </td>

                                        <td>
                                            @usage.CurrentReading
                                        </td>

                                        <td>
                                            @usage.Units m³
                                        </td>

                                        <td>

                                            @if (usage.Units <= 20)
                                            {
                                                <span class="badge bg-success">
                                                    Normal
                                                </span>
                                            }
                                            else if (usage.Units <= 30)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Moderate
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    High
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
