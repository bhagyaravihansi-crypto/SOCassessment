@page "/Customer/PaymentHistory"
@model PaymentHistoryModel
@{
    ViewData["Title"] = "Payment History";
    ViewData["ActiveDashboard"] = "PaymentHistory";
}

<div class="container py-4">
    <div class="row">

        <!-- Customer Sidebar -->
        <div class="col-lg-3 mb-4">
            <partial name="_CustomerSidebar" />
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">

            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold">Payment History</h3>

                    <p class="text-muted mb-0">
                        View your previous water bill payments
                    </p>
                </div>

                <div class="text-end">
                    <small class="text-muted">Account</small>
                    <div class="fw-semibold">
                        @Model.AccountNumber
                    </div>
                </div>
            </div>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">

                <!-- Total Payments -->
                <div class="col-md-4">
                    <div class="card p-3 shadow-sm h-100">

                        <small class="text-muted">
                            Total Payments
                        </small>

                        <div class="h3 fw-bold text-primary">
                            @Model.TotalPayments
                        </div>

                        <small class="text-muted">
                            Payment records
                        </small>

                    </div>
                </div>

                <!-- Total Paid -->
                <div class="col-md-4">
                    <div class="card p-3 shadow-sm h-100">

                        <small class="text-muted">
                            Total Paid
                        </small>

                        <div class="h3 fw-bold text-success">
                            LKR @Model.TotalPaid.ToString("N2")
                        </div>

                        <small class="text-muted">
                            All successful payments
                        </small>

                    </div>
                </div>

                <!-- Last Payment -->
                <div class="col-md-4">
                    <div class="card p-3 shadow-sm h-100">

                        <small class="text-muted">
                            Last Payment
                        </small>

                        <div class="h5 fw-bold">
                            LKR @Model.LastPaymentAmount.ToString("N2")
                        </div>

                        <small class="text-muted">
                            @(Model.LastPaymentDate?.ToString("dd MMM yyyy") ?? "-")
                        </small>

                    </div>
                </div>

            </div>

            <!-- Payment History Table -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Payment Transactions
                            </h5>

                            <small class="text-muted">
                                Your recent payment records
                            </small>
                        </div>

                    </div>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Reference</th>
                                    <th>Billing Period</th>
                                    <th>Method</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>

                                        <td>
                                            @payment.Date.ToString("dd MMM yyyy")
                                        </td>

                                        <td class="fw-semibold">
                                            @payment.Reference
                                        </td>

                                        <td>
                                            @payment.BillingPeriod
                                        </td>

                                        <td>
                                            @payment.Method
                                        </td>

                                        <td class="fw-semibold">
                                            LKR @payment.Amount.ToString("N2")
                                        </td>

                                        <td>

                                            @if (payment.Status == "Successful")
                                            {
                                                <span class="badge bg-success">
                                                    Successful
                                                </span>
                                            }
                                            else if (payment.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    Failed
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            <!-- Payment Information -->
            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="fw-bold">
                        Payment Information
                    </h6>

                    <p class="text-muted mb-0">
                        This page displays your previous water bill payment
                        transactions. The information currently shown is
                        sample data for demonstration purposes.
                    </p>

                </div>

            </div>

        </div>
    </div>
</div>

