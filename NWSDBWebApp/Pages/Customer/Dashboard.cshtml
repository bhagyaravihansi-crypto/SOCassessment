
@page "/Customer/Dashboard"
@model DashboardModel
@{
    ViewData["Title"] = "Customer Dashboard";
    ViewData["ActiveDashboard"] = "Dashboard";
}

<div class="container py-4">
    <div class="row">

        <!-- Customer Sidebar -->
        <div class="col-lg-3 mb-4">
            <partial name="_CustomerSidebar" />
        </div>

        <!-- Main Dashboard -->
        <div class="col-lg-9">

            <!-- Welcome Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold">Welcome back, @Model.CustomerName</h3>
                    <p class="text-muted">
                        Account:
                        <span class="fw-semibold">@Model.AccountNumber</span>
                    </p>
                </div>

                <div class="text-end">
                    <small class="text-muted">
                        Member since @Model.MemberSince.ToString("yyyy")
                    </small>
                </div>
            </div>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">

                <!-- Current Bill -->
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">Current Bill</small>

                        <div class="h4 fw-bold text-danger">
                            LKR @Model.CurrentBill.ToString("N2")
                        </div>

                        <small class="text-muted">
                            Due @Model.DueDate.ToString("dd MMM yyyy")
                        </small>
                    </div>
                </div>

                <!-- Water Usage -->
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">
                            Water Usage (This Month)
                        </small>

                        <div class="h4 fw-bold text-primary">
                            @Model.CurrentUsage m³
                        </div>

                        <small class="text-muted">
                            Prev: @Model.PreviousUsage m³
                        </small>
                    </div>
                </div>

                <!-- Last Payment -->
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">Last Payment</small>

                        <div class="h5 fw-bold">
                            LKR @Model.LastPaymentAmount.ToString("N2")
                        </div>

                        <small class="text-muted">
                            @Model.LastPaymentDate.ToString("dd MMM yyyy")
                        </small>
                    </div>
                </div>

                <!-- Payment Status -->
                <div class="col-md-3">
                    <div class="card p-3 shadow-sm h-100">
                        <small class="text-muted">Payment Status</small>

                        <div class="h5 fw-bold text-success">
                            @Model.PaymentStatus
                        </div>

                        <small class="text-muted">
                            Next due: @Model.DueDate.ToString("dd MMM")
                        </small>
                    </div>
                </div>

            </div>

            <!-- Quick Actions -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">

                    <h5 class="card-title fw-bold">
                        Quick Actions
                    </h5>

                    <div class="d-flex flex-wrap gap-2">

                        <a class="btn btn-outline-primary"
                           href="/Customer/CurrentBill">
                            View Current Bill
                        </a>

                        <a class="btn btn-primary"
                           href="/Customer/OnlinePayment">
                            Make Online Payment
                        </a>

                        <a class="btn btn-outline-primary"
                           href="/Customer/WaterUsage">
                            View Water Usage
                        </a>

                        <a class="btn btn-outline-primary"
                           href="/Customer/PaymentHistory">
                            View Payment History
                        </a>

                        <a class="btn btn-outline-primary"
                           href="/Customer/Profile">
                            View Customer Profile
                        </a>

                    </div>
                </div>
            </div>

            <!-- Recent Payments + Current Bill -->
            <div class="row">

                <!-- Recent Payments -->
                <div class="col-lg-6 mb-3">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <h6 class="fw-bold">
                                Recent Payments
                            </h6>

                            <div class="table-responsive">

                                <table class="table table-sm mt-2">

                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Reference</th>
                                            <th>Amount</th>
                                            <th>Method</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var p in Model.RecentPayments)
                                        {
                                            <tr>

                                                <td>
                                                    @p.Date.ToString("dd MMM yyyy")
                                                </td>

                                                <td>
                                                    @p.Reference
                                                </td>

                                                <td>
                                                    LKR @p.Amount.ToString("N2")
                                                </td>

                                                <td>
                                                    @p.Method
                                                </td>

                                                <td>
                                                    @p.Status
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Current Bill -->
                <div class="col-lg-6 mb-3">

                    <div class="card shadow-sm h-100">

                        <div class="card-body d-flex flex-column">

                            <h6 class="fw-bold">
                                Current Bill
                            </h6>

                            <div class="d-flex justify-content-between align-items-center mt-2 mb-3">

                                <!-- Billing Period -->
                                <div>
                                    <div class="small text-muted">
                                        Billing Period
                                    </div>

                                    <div class="h4 fw-bold">
                                        @Model.BillingPeriod
                                    </div>
                                </div>

                                <!-- Amount Due -->
                                <div class="text-end">

                                    <div class="small text-muted">
                                        Amount Due
                                    </div>

                                    <div class="h3 fw-bold text-danger">
                                        LKR @Model.CurrentBill.ToString("N2")
                                    </div>

                                </div>

                            </div>

                            <!-- Bill Actions -->
                            <div class="mt-auto d-flex gap-2">

                                <a class="btn btn-outline-primary"
                                   href="/Customer/CurrentBill">
                                    View Bill
                                </a>

                                <a class="btn btn-primary"
                                   href="/Customer/OnlinePayment">
                                    Pay Now
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
                 
            </div>

        </div>
    </div>
</div>
