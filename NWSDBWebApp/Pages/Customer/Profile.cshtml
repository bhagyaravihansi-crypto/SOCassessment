@page "/Customer/Profile"
@model ProfileModel
@{
    ViewData["Title"] = "Customer Profile";
    ViewData["ActiveDashboard"] = "Profile";
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            <partial name="_CustomerSidebar" />
        </div>
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h3 class="fw-bold">Customer Profile</h3>
                    <p class="text-muted mb-0">View and manage your account information</p>
                </div>
                <div class="text-end">
                    <small class="text-muted">Member since @Model.RegistrationDate.ToString("yyyy")</small>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-info">@Model.Message</div>
            }

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h6 class="fw-bold">Personal Details</h6>
                            <div class="mt-3">
                                <p class="mb-1"><strong>Full Name</strong><br /><span class="text-muted">@Model.FullName</span></p>
                                <p class="mb-1"><strong>Customer ID / Account Number</strong><br /><span class="text-muted">@Model.AccountNumber</span></p>
                                <p class="mb-1"><strong>NIC</strong><br /><span class="text-muted">@Model.NIC</span></p>
                                <p class="mb-1"><strong>Email Address</strong><br /><span class="text-muted">@Model.Email</span></p>
                                <p class="mb-1"><strong>Phone Number</strong><br /><span class="text-muted">@Model.PhoneNumber</span></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h6 class="fw-bold">Account Details</h6>
                            <div class="mt-3">
                                <p class="mb-1"><strong>Address</strong><br /><span class="text-muted">@Model.Address</span></p>
                                <p class="mb-1"><strong>Account Status</strong><br /><span class="text-muted">@Model.AccountStatus</span></p>
                                <p class="mb-1"><strong>Registration Date</strong><br /><span class="text-muted">@Model.RegistrationDate.ToString("dd MMM yyyy")</span></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <form method="post">
                    <button type="submit" name="action" value="edit" class="btn btn-primary">Edit Profile</button>
                </form>
                <div class="text-muted small">Account Information: This page shows sample/demo data for UI demonstration only.</div>
            </div>
        </div>
    </div>
</div>
