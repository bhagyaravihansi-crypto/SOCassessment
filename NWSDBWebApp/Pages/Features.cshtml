@page "/Features"
@model FeaturesModel
{
    ViewData["Title"] = "NWSDB Services & Features";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-6 fw-bold">NWSDB Services & Features</h1>
                <p class="lead text-muted">Simple and convenient water account management through one web application.</p>
                <div class="d-flex gap-2 mt-3">
                    <a class="btn btn-primary btn-lg" href="/Login">Login</a>
                    <a class="btn btn-outline-primary btn-lg" href="/Register">Register</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold">Why choose NWSDB?</h6>
                        <p class="text-muted">Manage bills, monitor usage, pay online and access customer services in a secure and convenient manner.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col text-center">
                <h2 class="fw-bold">Key Features</h2>
                <p class="text-muted">Features designed to help customers and administrators efficiently manage water services.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="mb-3">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2a4 4 0 00-4 4v3H6a2 2 0 00-2 2v5h16v-5a2 2 0 00-2-2h-2V6a4 4 0 00-4-4z" fill="#0b6fb8"/>
                            </svg>
                        </div>
                        <h5 class="card-title">Customer Registration & Login</h5>
                        <p class="card-text text-muted">Create an account and securely access your water services and billing information.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="mb-3">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="3" y="4" width="18" height="6" rx="1" fill="#0b6fb8" />
                                <rect x="3" y="12" width="12" height="8" rx="1" fill="#0b6fb8" opacity="0.8" />
                            </svg>
                        </div>
                        <h5 class="card-title">Current Bill</h5>
                        <p class="card-text text-muted">View your current bill, billing period, due date and amount payable with meter details.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="mb-3">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 12h18M7 6v12M17 6v12" stroke="#0b6fb8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h5 class="card-title">Water Usage</h5>
                        <p class="card-text text-muted">Monitor monthly consumption, compare previous months and view meter readings.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="mb-3">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M21 12v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6" stroke="#0b6fb8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M7 10l5-5 5 5" stroke="#0b6fb8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h5 class="card-title">Online Payment</h5>
                        <p class="card-text text-muted">Pay your bills quickly and securely using card, mobile or bank transfer options.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="mb-3">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 6h18M3 12h18M3 18h18" stroke="#0b6fb8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h5 class="card-title">Payment History</h5>
                        <p class="card-text text-muted">Access your past payments, view receipts and transaction details securely.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="mb-3">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="8" r="3" fill="#0b6fb8" />
                                <path d="M4 20c1-4 7-6 8-6s7 2 8 6" stroke="#0b6fb8" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <h5 class="card-title">Customer Profile</h5>
                        <p class="card-text text-muted">View and manage your personal and account information.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="mb-3">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 12h18" stroke="#0b6fb8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M8 6v12" stroke="#0b6fb8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <h5 class="card-title">Admin Management</h5>
                        <p class="card-text text-muted">Administrative tools for managing customers, bills, payments and usage.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="mb-3">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2l3 6 6 .5-4.5 3.5L19 18l-7-4-7 4 1.5-6.5L3 8.5 9 8z" fill="#0b6fb8"/>
                            </svg>
                        </div>
                        <h5 class="card-title">Easy Account Management</h5>
                        <p class="card-text text-muted">A dashboard-based experience giving quick access to important account information.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col">
                <div class="p-4 bg-primary text-white rounded shadow-sm text-center">
                    <h4 class="fw-bold">Manage Your Water Account Easily</h4>
                    <p class="mb-3">Access your bills, monitor water usage, make payments and manage your NWSDB account from one convenient platform.</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a class="btn btn-light" href="/Login">Login</a>
                        <a class="btn btn-outline-light" href="/Register">Register</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
