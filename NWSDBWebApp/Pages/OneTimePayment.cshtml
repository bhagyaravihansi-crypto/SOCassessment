@page
@model NWSDBWebApp.Pages.OneTimePaymentModel
@{
    ViewData["Title"] = "One-Time Payment";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-lightning-charge-fill me-2"></i>
            One-Time Payment
        </h2>

        <p class="text-muted">
            Make a quick NWSDB water bill payment without logging in.
        </p>
    </div>


    <!-- Payment Card -->
    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <!-- Payment Message -->
                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="alert @(Model.PaymentSuccessful ? "alert-success" : "alert-danger")">
                            <i class="bi @(Model.PaymentSuccessful ? "bi-check-circle-fill" : "bi-exclamation-circle-fill") me-2"></i>
                            @Model.Message
                        </div>
                    }


                    <form method="post">

                        <!-- Account Number -->
                        <div class="mb-3">

                            <label asp-for="AccountNumber"
                                   class="form-label fw-semibold">
                                NWSDB Account Number
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-person-vcard"></i>
                                </span>

                                <input asp-for="AccountNumber"
                                       class="form-control"
                                       placeholder="Example: NWS10001" />

                            </div>

                            <span asp-validation-for="AccountNumber"
                                  class="text-danger small"></span>

                        </div>


                        <!-- Customer Name -->
                        <div class="mb-3">

                            <label asp-for="CustomerName"
                                   class="form-label fw-semibold">
                                Customer Name
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>

                                <input asp-for="CustomerName"
                                       class="form-control"
                                       placeholder="Enter customer name" />

                            </div>

                        </div>


                        <!-- Payment Amount -->
                        <div class="mb-4">

                            <label asp-for="Amount"
                                   class="form-label fw-semibold">
                                Payment Amount
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    LKR
                                </span>

                                <input asp-for="Amount"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       placeholder="Enter amount" />

                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                You can pay the full bill, a partial amount,
                                or more than the current bill amount.
                            </div>

                        </div>


                        <!-- Payment Method -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Payment Method
                            </label>

                            <div class="row g-3">

                                <!-- Card -->
                                <div class="col-md-4">

                                    <div class="form-check border rounded p-3">

                                        <input asp-for="PaymentMethod"
                                               class="form-check-input"
                                               type="radio"
                                               value="Card"
                                               id="cardPayment" />

                                        <label class="form-check-label"
                                               for="cardPayment">

                                            <i class="bi bi-credit-card me-2"></i>
                                            Card

                                        </label>

                                    </div>

                                </div>


                                <!-- Mobile -->
                                <div class="col-md-4">

                                    <div class="form-check border rounded p-3">

                                        <input asp-for="PaymentMethod"
                                               class="form-check-input"
                                               type="radio"
                                               value="Mobile Payment"
                                               id="mobilePayment" />

                                        <label class="form-check-label"
                                               for="mobilePayment">

                                            <i class="bi bi-phone me-2"></i>
                                            Mobile

                                        </label>

                                    </div>

                                </div>


                                <!-- Bank -->
                                <div class="col-md-4">

                                    <div class="form-check border rounded p-3">

                                        <input asp-for="PaymentMethod"
                                               class="form-check-input"
                                               type="radio"
                                               value="Bank"
                                               id="bankPayment" />

                                        <label class="form-check-label"
                                               for="bankPayment">

                                            <i class="bi bi-bank me-2"></i>
                                            Bank

                                        </label>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Card Details -->
                        <div class="border rounded p-4 mb-4 bg-light">

                            <h6 class="fw-bold mb-3">
                                <i class="bi bi-credit-card-2-front me-2"></i>
                                Payment Details
                            </h6>


                            <!-- Cardholder Name -->
                            <div class="mb-3">

                                <label asp-for="CardholderName"
                                       class="form-label">
                                    Cardholder Name
                                </label>

                                <input asp-for="CardholderName"
                                       class="form-control"
                                       placeholder="Enter cardholder name" />

                            </div>


                            <!-- Card Number -->
                            <div class="mb-3">

                                <label asp-for="CardNumber"
                                       class="form-label">
                                    Card Number
                                </label>

                                <input asp-for="CardNumber"
                                       class="form-control"
                                       placeholder="XXXX XXXX XXXX XXXX"
                                       maxlength="19" />

                            </div>


                            <!-- Expiry + CVV -->
                            <div class="row">

                                <div class="col-md-6">

                                    <label asp-for="Expiry"
                                           class="form-label">
                                        Expiry Date
                                    </label>

                                    <input asp-for="Expiry"
                                           class="form-control"
                                           placeholder="MM/YY" />

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="CVV"
                                           class="form-label">
                                        CVV
                                    </label>

                                    <input asp-for="CVV"
                                           class="form-control"
                                           type="password"
                                           placeholder="CVV"
                                           maxlength="4" />

                                </div>

                            </div>

                        </div>


                        <!-- Pay Button -->
                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">

                                <i class="bi bi-lock-fill me-2"></i>
                                Pay Now

                            </button>

                        </div>


                        <!-- Security Notice -->
                        <div class="text-center mt-3">

                            <small class="text-muted">

                                <i class="bi bi-shield-check me-1"></i>

                                Your payment information is securely processed.

                            </small>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- Back to Home - Bottom Left -->
    <div class="mt-4">

        <a asp-page="/Index"
           class="btn btn-outline-primary">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Home

        </a>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}